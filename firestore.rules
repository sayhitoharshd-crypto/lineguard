rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if false;
      // Profiles and all counters are created/updated only by trusted Cloud Functions.
      allow create, update, delete: if false;
      match /repLog/{entryId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if false;
      match /votes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
    }

    match /privateReports/{reportId} {
      allow read: if isStaff() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow write: if false;
    }

    match /appeals/{appealId} {
      allow get: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isStaff();
      allow create, update, delete: if false;
    }

    match /shameboard/{subjectKey} {
      allow read: if true;
      allow write: if false;
    }

    match /community/{postId} {
      allow read: if true;
      allow write: if false;
      match /likes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
    }
  }
}
